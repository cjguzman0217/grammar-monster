    "label": "parts-of-speech lists",
    "href": "https://www.grammar-monster.com/parts_of_speech_lists.htm"
  },
  {
    "label": "easily confused words",
    "href": "https://www.grammar-monster.com/easily_confused_words.htm"
  },
  {
    "label": "grammar glossary",
    "href": "https://www.grammar-monster.com/grammar_terms_and_definitions.htm"
  },
  {
    "label": "all punctuation lessons",
    "href": "https://www.grammar-monster.com/punctuation_lessons.htm"
  }
];
const relatedLinks = [
  {
    "label": "A list of common grammar errors",
    "href": "https://www.grammar-monster.com/common_grammar_errors.htm"
  },
  {
    "label": "A list of easily confused words",
    "href": "https://www.grammar-monster.com/easily_confused_words.htm"
  },
  {
    "label": "A list of sayings and proverbs",
    "href": "https://www.grammar-monster.com/sayings_proverbs.htm"
  }
];

const totalListed =
  vocabularyGames.length +
  partsOfSpeechGroups.reduce((sum, group) => sum + group.links.length, 0) +
  punctuationTests.length +
  grammarTermTests.length +
  confusedWordTests.length +
  usefulTests.length;
---

<BaseLayout
  title="Free Grammar Tests & Games | Grammar Monster"
  description="Hundreds of free Grammar Monster tests and games, grouped by grammar topic, punctuation, vocabulary and parts of speech."
>
  <script is:inline>
    window.vitag = window.vitag || {};
    window.vitag.smartBannerConfig = { enablePC: false, enableMobile: false };
  </script>
  <script is:inline async src="https://services.vlitag.com/adv1/?q=30b982bcceb31097305670acdcf26233"></script>

  <main class="gm-games">
    <section class="games-hero">
      <div class="games-shell games-hero__grid">
        <div class="games-hero__copy">
          <nav class="games-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a><span>›</span><strong>Games & Tests</strong>
          </nav>

          <span class="games-kicker games-kicker--lime">PRACTISE · PLAY · REMEMBER</span>
          <h1>Free grammar tests.<br /><em>Thousands of ways to practise.</em></h1>

          <p class="games-hero__lede">
            Explore free tests and games on English grammar, grouped by part of speech
            and major topics such as punctuation and vocabulary.
          </p>

          <div class="games-hero__facts">
            <div><strong>100s</strong><span>listed here</span></div>
            <i></i>
            <div><strong>1000s</strong><span>across the site</span></div>
            <i></i>
            <div><strong>0</strong><span>accounts required</span></div>
          </div>

          <div class="games-search">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m21 21-4.2-4.2m1.2-5.8A7 7 0 1 1 4 11a7 7 0 0 1 14 0Z"></path>
            </svg>
            <input
              id="gamesSearch"
              type="search"
              placeholder="Search adjectives, commas, Wordle, pronouns..."
              aria-label="Search Grammar Monster games and tests"
            />
            <button id="gamesSearchButton" type="button">Search</button>
          </div>

          <div class="games-filter-row" aria-label="Jump to a section">
            <a href="#games">Games</a>
            <a href="#parts-of-speech">Parts of speech</a>
            <a href="#punctuation">Punctuation</a>
            <a href="#grammar-terms">Grammar terms</a>
            <a href="#teachers">Teachers</a>
          </div>
        </div>

        <div class="games-hero__visual">
          <div class="games-hero__rings"></div>
          <div class="games-hero__art-card">
            <img
              src="https://www.grammar-monster.com/images/free-grammar-tests.webp"
              alt="Grammar Monster free grammar tests"
            />
          </div>
          <div class="games-float games-float--one"><span>✓</span> FREE TO USE</div>
          <div class="games-float games-float--two"><span>↗</span> SENDABLE TESTS</div>
        </div>
      </div>
    </section>

    <section class="games-intro">
      <div class="games-shell games-intro__grid">
        <div>
          <span class="games-kicker">LIST OF ENGLISH GRAMMAR TESTS</span>
          <h2>Practise by topic.<br /><em>Teach without the admin.</em></h2>
        </div>

        <div class="games-intro__copy">
          <p>
            The tests on this page are just a sample. Every lesson on Grammar Monster has
            at least one multiple-choice interactive test, and those lesson tests are
            editable and printable.
          </p>
          <p>
            The vast majority of Grammar Monster tests are also sendable. Teachers can set
            assignments without requiring students to create accounts or log in; question
            and answer data is passed through the URLs shared between teacher and student.
          </p>
          <a href="https://www.grammar-monster.com/admin/paper-free-learning.htm">
            Learn about paper-free learning →
          </a>
        </div>
      </div>
    </section>

    <section class="games-ad-stage" aria-label="Advertisement">
      <div class="games-shell">
        <div class="games-ad-label">ADVERTISEMENT <span>Ads help keep Grammar Monster free.</span></div>
        <div class="games-ad-grid">
          <div class="games-ad-slot" data-games-ad-shell>
            <div class="games-ad-placeholder"><span>ADVERTISEMENT</span><strong>Grammar Monster stays free.</strong><small>Live ad inventory may appear here.</small></div>
            <div class="adsbyvli" style="width:300px;height:250px" data-ad-slot="vi_342100586"></div>
          </div>
          <div class="games-ad-slot games-ad-slot--secondary" data-games-ad-shell>
            <div class="games-ad-placeholder"><span>ADVERTISEMENT</span><strong>Free learning, supported by ads.</strong><small>Thanks for supporting the site.</small></div>
            <div class="adsbyvli" style="width:300px;height:250px" data-ad-slot="vi_342112530"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="games-featured" id="games" data-library-section>
      <div class="games-shell">
        <div class="games-section-head">
          <div>
            <span class="games-kicker">VOCABULARY GAMES</span>
            <h2>Start with something fun.</h2>
          </div>
          <p>Daily challenges and Grammar Monster classics for vocabulary, spelling and word-building.</p>
        </div>

        <div class="games-featured-grid">
          {featuredGames.map((game, index) => (
            <a
              class:list={["games-feature-card", index < 2 && "games-feature-card--live"]}
              href={game.href}
              data-library-item
              data-search={`${game.title} ${game.eyebrow} ${game.description} ${game.meta} vocabulary games`}
            >
              <div class="games-feature-card__top">
                <span>{game.eyebrow}</span>
                <b>{game.badge}</b>
              </div>
              <div class="games-feature-card__glyph">{game.glyph}</div>
              <h3>{game.title}</h3>
              <p>{game.description}</p>
              <div class="games-feature-card__bottom">
                <span>{game.meta}</span>
                <strong>Play →</strong>
              </div>
            </a>
          ))}
        </div>

        <div class="games-classic-links">
          {vocabularyGames.map((game) => (
            <a href={game.href} data-library-item data-search={`${game.label} vocabulary game`}>
              <span>WORD GAME</span>
              <strong>{game.label}</strong>
              <b>↗</b>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="games-library games-library--tinted" id="parts-of-speech" data-library-section>
      <div class="games-shell">
        <div class="games-section-head games-section-head--wide">
          <div>
            <span class="games-kicker">TESTS ON THE PARTS OF SPEECH</span>
            <h2>Grammar practice,<br /><em>one word class at a time.</em></h2>
          </div>
          <p>Word finders, hangman, bubble pop, whack-a-word, fish games, drag-and-drop and matching activities.</p>
        </div>

        <div class="games-topic-grid">
          {partsOfSpeechGroups.map((group, index) => (
            <article class="games-topic-card" data-library-card>
              <div class="games-topic-card__head">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{group.title}</h3>
                  <small>{group.links.length} {group.links.length === 1 ? "activity" : "activities"}</small>
                </div>
              </div>

              <div class="games-link-list">
                {group.links.map((link) => (
                  <a href={link.href} data-library-item data-search={`${group.title} ${link.label} grammar parts of speech`}>
                    <span>{link.label}</span><b>→</b>
                  </a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="games-library" id="punctuation" data-library-section>
      <div class="games-shell games-library__split">
        <div class="games-library__intro">
          <span class="games-kicker">PUNCTUATION</span>
          <h2>Put every mark<br /><em>in its place.</em></h2>
          <p>Apostrophes, commas, hyphens, semicolons, quotation marks and general punctuation practice.</p>
          <a href="/punctuation-lessons/">Browse punctuation lessons →</a>
        </div>

        <div class="games-link-panel">
          {punctuationTests.map((link, index) => (
            <a href={link.href} data-library-item data-search={`${link.label} punctuation apostrophes commas hyphens semicolons quotation marks`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{link.label}</strong>
              <b>↗</b>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="games-library games-library--dark" id="grammar-terms" data-library-section>
      <div class="games-shell">
        <div class="games-section-head games-section-head--dark">
          <div>
            <span class="games-kicker games-kicker--lime">GRAMMAR TERMS & DEFINITIONS</span>
            <h2>A deep test library.<br /><em>Pick the exact concept.</em></h2>
          </div>
          <p>From abbreviations and affixes to pronouns, participles, tenses and syllables.</p>
        </div>

        <div class="games-term-toolbar">
          <strong>{grammarTermTests.length} listed tests</strong>
          <a href="/grammar-terms/">Open the Grammar & Terms library →</a>
        </div>

        <div class="games-term-grid">
          {grammarTermTests.map((link, index) => (
            <a href={link.href} data-library-item data-search={`${link.label} grammar terms definitions`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{link.label}</strong>
              <b>↗</b>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="games-library games-library--tinted" id="confused-words" data-library-section>
      <div class="games-shell">
        <div class="games-duo-grid">
          <article class="games-special-card">
            <span class="games-kicker">EASILY CONFUSED WORDS</span>
            <h2>Know which word<br /><em>belongs where.</em></h2>
            <p>Practise commonly confused words with the main test or the Tetris-style game.</p>
            <div class="games-special-links">
              {confusedWordTests.map((link) => (
                <a href={link.href} data-library-item data-search={`${link.label} confused words vocabulary tetris`}>
                  <strong>{link.label}</strong><b>→</b>
                </a>
              ))}
            </div>
            <a class="games-special-card__library" href="/easily-confused-words/">Explore Easily Confused Words →</a>
          </article>

          <article class="games-special-card games-special-card--blue">
            <span class="games-kicker">MORE USEFUL GRAMMAR TESTS</span>
            <h2>Quick checks for<br /><em>awkward little rules.</em></h2>
            <p>From “an or a” and capital letters to “who and whom”, numbers and common usage choices.</p>
            <div class="games-special-links games-special-links--compact">
              {usefulTests.map((link) => (
                <a href={link.href} data-library-item data-search={`${link.label} useful grammar test`}>
                  <strong>{link.label}</strong><b>→</b>
                </a>
              ))}
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="games-teachers" id="teachers" data-library-section>
      <div class="games-shell games-teachers__grid">
        <div class="games-teachers__copy">
          <span class="games-kicker games-kicker--lime">TEACHERS' ZONE</span>
          <h2>Set practice.<br />Skip the paperwork.</h2>
          <p>
            Jump into classroom-friendly games, spelling practice, grammar references
            and shareable tests.
          </p>

          <div class="games-teachers__badge">
            <span>NO ACCOUNT</span>
            <strong>Send tests as homework using a link.</strong>
          </div>
        </div>

        <div class="games-teachers__links">
          {teacherZone.map((link, index) => (
            <a href={link.href} data-library-item data-search={`${link.label} teachers classroom homework`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{link.label}</strong>
              <b>↗</b>
            </a>
          ))}

          <a class="games-teachers__quick" href="/#quiz" data-library-item data-search="multi choice test quick grammar challenge ten questions">
            <span>10Q</span>
            <strong>Quick Grammar Challenge</strong>
            <b>→</b>
          </a>
        </div>
      </div>
    </section>

    <section class="games-more">
      <div class="games-shell">
        <div class="games-more__head">
          <div>
            <span class="games-kicker">KEEP EXPLORING</span>
            <h2>You might also like...</h2>
          </div>
          <strong>{totalListed} direct activities listed on this page</strong>
        </div>

        <div class="games-related-grid">
          {relatedLinks.map((link) => (
            <a href={link.href}>
              <strong>{link.label}</strong>
              <span>Explore →</span>
            </a>
          ))}
        </div>

        <div class="games-author">
          <img src="/assets/images/grammarMonsterEye.webp" alt="" aria-hidden="true" />
          <div>
            <span>ABOUT THIS PAGE</span>
            <p>
              This page was written by
              <a href="https://www.grammar-monster.com/Craig_Shrives_author.htm">Craig Shrives</a>.
            </p>
          </div>
        </div>

        <p class="games-no-results" id="gamesNoResults" hidden>
          No matching games or tests found. Try another word or topic.
        </p>
      </div>
    </section>

    <section class="games-ad-stage games-ad-stage--bottom" aria-label="Advertisement">
      <div class="games-shell">
        <div class="games-ad-label">ADVERTISEMENT <span>Helping keep Grammar Monster free.</span></div>
        <div class="games-ad-grid">
          <div class="games-ad-slot" data-games-ad-shell>
            <div class="games-ad-placeholder"><span>ADVERTISEMENT</span><strong>More free Grammar Monster.</strong><small>Live ad inventory may appear here.</small></div>
            <div class="adsbyvli" style="width:300px;height:250px" data-ad-slot="vi_342112533"></div>
          </div>
          <div class="games-ad-slot games-ad-slot--secondary" data-games-ad-shell>
            <div class="games-ad-placeholder"><span>ADVERTISEMENT</span><strong>Learning without a paywall.</strong><small>Thanks for supporting the site.</small></div>
            <div class="adsbyvli" style="width:300px;height:250px" data-ad-slot="vi_342112534"></div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const input = document.getElementById("gamesSearch");
      const button = document.getElementById("gamesSearchButton");
      const items = [...document.querySelectorAll("[data-library-item]")];
      const cards = [...document.querySelectorAll("[data-library-card]")];
      const sections = [...document.querySelectorAll("[data-library-section]")];
      const noResults = document.getElementById("gamesNoResults");

      function applySearch() {
        const term = (input?.value || "").trim().toLowerCase();
        let visible = 0;

        items.forEach((item) => {
          const haystack = (item.getAttribute("data-search") || item.textContent || "").toLowerCase();
          const show = !term || haystack.includes(term);
          item.hidden = !show;
          if (show) visible += 1;
        });

        cards.forEach((card) => {
          const cardItems = [...card.querySelectorAll("[data-library-item]")];
          card.hidden = term !== "" && cardItems.every((item) => item.hidden);
        });

        sections.forEach((section) => {
          const sectionItems = [...section.querySelectorAll("[data-library-item]")];
          section.classList.toggle("is-search-empty", term !== "" && sectionItems.length > 0 && sectionItems.every((item) => item.hidden));
        });

        if (noResults) noResults.hidden = visible !== 0;

        if (term && visible > 0) {
          const first = items.find((item) => !item.hidden);
          first?.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      }

      button?.addEventListener("click", applySearch);
      input?.addEventListener("input", () => {
        if (!input.value.trim()) applySearch();
      });
      input?.addEventListener("keydown", (event) => {
        if (event.key === "Enter") applySearch();
      });

      const adSlots = ["vi_342100586", "vi_342112530", "vi_342112533", "vi_342112534"];
      if (window.vitag) {
        (window.vitag.Init = window.vitag.Init || []).push(() => {
          adSlots.forEach((slot) => {
            try { window.viAPItag?.display(slot); } catch (_) {}
          });
        });
      }

      document.querySelectorAll("[data-games-ad-shell]").forEach((shell) => {
        const ad = shell.querySelector(".adsbyvli");
        const placeholder = shell.querySelector(".games-ad-placeholder");
        if (!ad || !placeholder) return;

        const update = () => {
          const live = Boolean(ad.querySelector("iframe") || ad.children.length);
          placeholder.hidden = live;
          shell.classList.toggle("has-live-ad", live);
        };

        new MutationObserver(update).observe(ad, { childList: true, subtree: true });
        setTimeout(update, 1800);
        setTimeout(update, 4200);
      });
    })();
  </script>
</BaseLayout>
