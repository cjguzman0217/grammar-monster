---

<BaseLayout
  title="Explore Grammar Monster — Sitemap & Explore Grammar Monster"
  description="Search and explore Grammar Monster's lessons, tests, word lists, grammar references and learning resources."
>
  <div class="knowledge-hub">
    <section class="kh-hero">
      <div class="kh-shell kh-hero__grid">
        <div class="kh-hero__copy">
          <div class="kh-kicker"><span></span> EXPLORE GRAMMAR MONSTER</div>
          <h1>Find what you need.<br /><em>Explore everything.</em></h1>
          <p>
            The best way to find something on Grammar Monster is to use the search bar.
            However, if you’re unsure what you need, browse the categorized sitemap below
            or jump straight into one of our main learning libraries.
          </p>

          <div class="kh-search">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m21 21-4.2-4.2m1.2-5.8A7 7 0 1 1 4 11a7 7 0 0 1 14 0Z"></path>
            </svg>
            <input
              id="knowledgeSearch"
              type="search"
              placeholder="Search nouns, commas, idioms, tenses, tests..."
              autocomplete="off"
              aria-label="Search Grammar Monster categorized sitemap"
            />
            <kbd>/</kbd>
          </div>

          <div class="kh-quick">
            <span>Try:</span>
            <button data-quick="nouns">Nouns</button>
            <button data-quick="commas">Commas</button>
            <button data-quick="verbs">Verbs</button>
            <button data-quick="idioms">Idioms</button>
            <button data-quick="tests">Tests</button>
          </div>
        </div>

        <div class="kh-hero__visual" aria-hidden="true">
          <div class="kh-orbit kh-orbit--one"></div>
          <div class="kh-orbit kh-orbit--two"></div>
          <div class="kh-monster-disc">
            <img src="/assets/images/grammarMonsterEye.webp" alt="" />
          </div>
          <div class="kh-float kh-float--top">
            <span>18</span>
            <small>main libraries</small>
          </div>
          <div class="kh-float kh-float--bottom">
            <span>{totalLinks.toLocaleString()}</span>
            <small>resources to explore</small>
          </div>
        </div>
      </div>

      <div class="kh-shell">
        <div class="kh-proof">
          <div><strong>2,000+</strong><span>free lessons across the wider site</span></div>
          <div><strong>{libraries.length}</strong><span>categorized library families</span></div>
          <div><strong>{totalLinks.toLocaleString()}</strong><span>resources in the categorized sitemap</span></div>
          <div><strong>Free</strong><span>to explore across Grammar Monster</span></div>
        </div>
      </div>
    </section>

    <section class="kh-featured">
      <div class="kh-shell">
        <div class="kh-section-head">
          <div>
            <div class="kh-kicker kh-kicker--dark"><span></span> POPULAR PLACES TO START</div>
            <h2>Explore our main libraries.</h2>
          </div>
          <p>Start with one of our most useful collections, or search the full sitemap below.</p>
        </div>

        <div class="kh-feature-grid">
          {
            featured.map((library, index) => (
              <article
                class:list={[
                  "kh-feature-card",
                  `kh-accent-${(index % 6) + 1}`,
                  index === 0 && "kh-feature-card--lead",
                  index === 2 && "kh-feature-card--dark",
                ]}
                data-card-search={(library.title + " " + descriptions[library.title]).toLowerCase()}
              >
                <div class="kh-feature-card__top">
                  <div class="kh-feature-icon">{icons[library.title] || "•"}</div>
                  <span>{getCount(library)} resources</span>
                </div>
                <h3>{library.title}</h3>
                <p>{descriptions[library.title]}</p>
                <button
                  class="kh-jump"
                  type="button"
                  data-jump={library.title}
                >
                  Explore this library <b>↓</b>
                </button>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="kh-map" id="knowledge-map">
      <div class="kh-shell">
        <div class="kh-map__intro">
          <div>
            <div class="kh-kicker kh-kicker--dark"><span></span> THE CATEGORIZED SITEMAP</div>
            <h2>Everything in one place.<br /><em>Easy to browse. Easy to search.</em></h2>
          </div>
          <p>
            Browse Grammar Monster by subject, open a library to see its categories,
            or use the search box to find a specific topic, lesson, test, list or resource.
          </p>
        </div>

        <div class="kh-toolbar">
          <div class="kh-toolbar__result">
            <span id="resultCount">{totalLinks.toLocaleString()}</span>
            <small>destinations visible</small>
          </div>
          <div class="kh-toolbar__actions">
            <button id="expandAll" type="button">Expand all</button>
            <button id="collapseAll" type="button">Collapse all</button>
            <button id="clearSearch" type="button">Clear search</button>
          </div>
        </div>

        <div class="kh-library-list" id="libraryList">
          {
            libraries.map((library, libraryIndex) => (
              <details
                class:list={["kh-library", `kh-accent-${(libraryIndex % 6) + 1}`]}
                data-library
                data-title={library.title.toLowerCase()}
                open={libraryIndex < 2}
              >
                <summary>
                  <div class="kh-library__number">{String(libraryIndex + 1).padStart(2, "0")}</div>
                  <div class="kh-library__identity">
                    <div class="kh-library__icon">{icons[library.title] || "•"}</div>
                    <div>
                      <h3>{library.title}</h3>
                      <p>{descriptions[library.title] || "Explore this Grammar Monster library."}</p>
                    </div>
                  </div>
                  <div class="kh-library__meta">
                    <span>{library.groups.length} groups</span>
                    <strong>{getCount(library)} links</strong>
                  </div>
                  <div class="kh-library__chevron">⌄</div>
                </summary>

                <div class="kh-library__body">
                  {
                    library.groups.map((group) => (
                      <section class="kh-group" data-group>
                        {group.title && <h4>{group.title}</h4>}
                        <div class="kh-link-grid">
                          {
                            group.links.map((link) => (
                              <a
                                href={link.href}
                               
                                data-resource
                                data-search={(library.title + " " + group.title + " " + link.label).toLowerCase()}
                              >
                                <span>{link.label}</span>
                                <b>↗</b>
                              </a>
                            ))
                          }
                        </div>
                      </section>
                    ))
                  }
                </div>
              </details>
            ))
          }
        </div>

        <div class="kh-empty" id="emptyState" hidden>
          <div>?</div>
          <h3>No matching destination yet.</h3>
          <p>Try a broader term — for example “verb”, “punctuation”, “writing” or “test”.</p>
        </div>
      </div>
    </section>

    <section class="kh-note">
      <div class="kh-shell">
        <div class="kh-note__panel">
          <div class="kh-note__mark">GM</div>
          <div>
            <span>GRAMMAR MONSTER</span>
            <h2>Clear English. Better navigation.</h2>
            <p>
              Grammar Monster contains a huge collection of lessons, tests, word lists,
              videos and reference material. This page brings those resources together
              so you can get where you need to go quickly.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    const search = document.getElementById("knowledgeSearch");
    const libraries = [...document.querySelectorAll("[data-library]")];
    const resultCount = document.getElementById("resultCount");
    const emptyState = document.getElementById("emptyState");

    const normalize = (value) =>
      (value || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");

    function runSearch(rawValue) {
      const term = normalize(rawValue.trim());
      let visibleResources = 0;
      let visibleLibraries = 0;

      libraries.forEach((library) => {
        let libraryMatches = 0;

        library.querySelectorAll("[data-group]").forEach((group) => {
          let groupMatches = 0;

          group.querySelectorAll("[data-resource]").forEach((resource) => {
            const haystack = normalize(resource.dataset.search);
            const match = !term || haystack.includes(term);
            resource.hidden = !match;

            if (match) {
              groupMatches++;
              libraryMatches++;
              visibleResources++;
            }
          });

          group.hidden = groupMatches === 0;
        });

        const titleMatch = normalize(library.dataset.title).includes(term);
        const showLibrary = !term || libraryMatches > 0 || titleMatch;
        library.hidden = !showLibrary;

        if (showLibrary) {
          visibleLibraries++;
          if (term) library.open = true;
        }
      });

      if (resultCount) resultCount.textContent = visibleResources.toLocaleString();
      if (emptyState) emptyState.hidden = visibleLibraries !== 0;
    }

    search?.addEventListener("input", () => runSearch(search.value));

    document.querySelectorAll("[data-quick]").forEach((button) => {
      button.addEventListener("click", () => {
        const value = button.dataset.quick || "";
        if (search) {
          search.value = value;
          search.focus();
        }
        runSearch(value);
        document.getElementById("knowledge-map")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    document.querySelectorAll("[data-jump]").forEach((button) => {
      button.addEventListener("click", () => {
        const target = button.dataset.jump;
        const match = libraries.find((library) =>
          library.querySelector("h3")?.textContent?.trim() === target
        );

        if (match) {
          match.hidden = false;
          match.open = true;
          match.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });

    document.getElementById("expandAll")?.addEventListener("click", () => {
      libraries.filter((library) => !library.hidden).forEach((library) => library.open = true);
    });

    document.getElementById("collapseAll")?.addEventListener("click", () => {
      libraries.forEach((library) => library.open = false);
    });

    document.getElementById("clearSearch")?.addEventListener("click", () => {
      if (search) search.value = "";
      runSearch("");
      libraries.forEach((library, index) => library.open = index < 2);
    });

    document.addEventListener("keydown", (event) => {
      const tag = document.activeElement?.tagName;

      if (event.key === "/" && tag !== "INPUT" && tag !== "TEXTAREA") {
        event.preventDefault();
        search?.focus();
      }

      if (event.key === "Escape" && document.activeElement === search) {
        search.value = "";
        runSearch("");
        search.blur();
      }
    });
  </script>
</BaseLayout>
