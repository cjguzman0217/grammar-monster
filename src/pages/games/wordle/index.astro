---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/wordle.css";

const relatedGames = [
  {
    title: "WordUp",
    description: "Build a ladder of words to reach the top.",
    href: "https://www.grammar-monster.com/learning_games/wordup.htm",
    number: "01"
  },
  {
    title: "Word Builder",
    description: "See how many words you can find.",
    href: "https://www.grammar-monster.com/learning_games/wordBuilder.htm",
    number: "02"
  },
  {
    title: "Hangman",
    description: "Find the secret word before time runs out.",
    href: "https://www.grammar-monster.com/learning_games/hangMan.htm",
    number: "03"
  },
  {
    title: "Countdown",
    description: "Find the longest word you can.",
    href: "https://www.grammar-monster.com/learning_games/countdown.htm",
    number: "04"
  }
];

const teacherLinks = [
  ["Word Builder", "https://www.grammar-monster.com/learning_games/wordBuilder.htm"],
  ["WordUp", "https://www.grammar-monster.com/learning_games/wordup.htm"],
  ["Hangman", "https://www.grammar-monster.com/learning_games/hangMan.htm"],
  ["Countdown", "https://www.grammar-monster.com/learning_games/countdown.htm"],
  ["Look-cover-write-check", "https://www.grammar-monster.com/tests/look-cover-write-check.htm"],
  ["Spelling & vocabulary", "/spelling-vocabulary/"]
];
---

<BaseLayout
  title="Wordle | Grammar Monster"
  description="Play Grammar Monster Wordle. Guess the secret five-letter word in six tries, with advanced and learner modes."
>
  <script is:inline>
    window.vitag = window.vitag || {};
    window.vitag.smartBannerConfig = { enablePC: false, enableMobile: false };
  </script>
  <script is:inline async src="https://services.vlitag.com/adv1/?q=30b982bcceb31097305670acdcf26233"></script>

  <main class="gm-wordle">
    <section class="wordle-hero">
      <div class="wordle-shell wordle-hero__grid">
        <div class="wordle-hero__copy">
          <nav class="wordle-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>›</span>
            <a href="/games/">Games & Tests</a>
            <span>›</span>
            <strong>Wordle</strong>
          </nav>

          <span class="wordle-kicker wordle-kicker--lime">GRAMMAR MONSTER GAME</span>
          <h1>Welcome to<br /><em>Wordle!</em></h1>

          <p class="wordle-hero__lede">
            Wordle is a popular online game based on the 1970s board game
            “Mastermind” and its 1975 follow-up “Word Mastermind.”
          </p>

          <div class="wordle-hero__stats" aria-label="Game format">
            <div><strong>5</strong><span>letters</span></div>
            <i></i>
            <div><strong>6</strong><span>tries</span></div>
            <i></i>
            <div><strong>2</strong><span>modes</span></div>
          </div>

          <div class="wordle-hero__actions">
            <a href="#play">Play today's game <span>↓</span></a>
            <button type="button" data-open-instructions>How to play</button>
          </div>
        </div>

        <div class="wordle-hero__visual">
          <div class="wordle-hero__halo"></div>
          <div class="wordle-art-card">
            <img src="/assets/images/wordle.webp" alt="Grammar Monster Wordle game artwork" />
          </div>
          <div class="wordle-float wordle-float--one"><span>●</span> DAILY WORD</div>
          <div class="wordle-float wordle-float--two"><span>✓</span> LEARNER MODE</div>
        </div>
      </div>
    </section>

    <section class="wordle-intro">
      <div class="wordle-shell wordle-intro__grid">
        <div>
          <span class="wordle-kicker">LET'S PLAY WORDLE</span>
          <h2>Logic meets<br /><em>vocabulary.</em></h2>
        </div>
        <div class="wordle-intro__copy">
          <p>
            It is a word-guessing game that challenges players to uncover a hidden
            five-letter word in just six tries. With each guess, players receive
            feedback in the form of colour-coded tiles.
          </p>
          <p>
            The game combines logic and vocabulary into a daily brain teaser.
            Wordle was created by
            <a href="https://en.wikipedia.org/wiki/Wordle" target="_blank" rel="noopener">Josh Wardle</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="wordle-ad-stage" aria-label="Advertisement">
      <div class="wordle-shell">
        <div class="wordle-ad-stage__label">ADVERTISEMENT <span>Ads help keep Grammar Monster free.</span></div>
        <div class="wordle-ad-stage__slots">
          <div class="wordle-ad-slot" data-wordle-ad-shell>
            <div class="wordle-ad-placeholder">
              <span>ADVERTISEMENT</span>
              <strong>Free games, supported by ads.</strong>
              <small>Live ad inventory may appear here.</small>
            </div>
            <div class="adsbyvli" style="width:300px;height:250px" data-ad-slot="vi_342100586"></div>
          </div>
          <div class="wordle-ad-slot wordle-ad-slot--secondary" data-wordle-ad-shell>
            <div class="wordle-ad-placeholder">
              <span>ADVERTISEMENT</span>
              <strong>Grammar Monster stays free.</strong>
              <small>Thanks for supporting the site.</small>
            </div>
            <div class="adsbyvli" style="width:300px;height:250px" data-ad-slot="vi_342112530"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="wordle-play" id="play">
      <div class="wordle-shell">
        <div class="wordle-play__head">
          <div>
            <span class="wordle-kicker">TODAY'S WORDLE</span>
            <h2>Find the secret word.</h2>
          </div>
          <div class="wordle-mode" role="group" aria-label="Choose difficulty">
            <button type="button" class="is-active" data-wordle-mode="advanced">
              <strong>Advanced</strong>
              <span>Any valid 5-letter word</span>
            </button>
            <button type="button" data-wordle-mode="learner">
              <strong>Learner</strong>
              <span>Common 5-letter words</span>
            </button>
          </div>
        </div>

        <div class="wordle-game-shell">
          <div class="wordle-game-shell__top">
            <div>
              <span class="wordle-game-dot"></span>
              <strong data-game-label>DAILY GAME</strong>
            </div>
            <p data-game-date></p>
            <button type="button" data-open-instructions aria-label="Open instructions">?</button>
          </div>

          <div class="wordle-status" data-wordle-status aria-live="polite">
            Find the secret word.
          </div>

          <div
            class="wordle-board"
            data-wordle-board
            role="grid"
            aria-label="Wordle board: six guesses of five letters"
          ></div>

          <div class="wordle-keyboard" data-wordle-keyboard aria-label="On-screen keyboard"></div>

          <div class="wordle-game-actions">
            <button type="button" data-restart-daily>
              <span>↻</span>
              <div><strong>Restart today's game</strong><small data-mode-caption>Advanced mode</small></div>
            </button>
            <button type="button" data-random-game>
              <span>✦</span>
              <div><strong>Play a random game</strong><small data-mode-caption>Advanced mode</small></div>
            </button>
            <button type="button" class="wordle-share-result" data-share-result hidden>
              <span>↗</span>
              <div><strong>Share result</strong><small>No answer revealed</small></div>
            </button>
          </div>
        </div>

        <p class="wordle-play__tip">
          You can use your physical keyboard too. Press <kbd>Enter</kbd> to submit
          and <kbd>Backspace</kbd> to delete.
        </p>
      </div>
    </section>

    <section class="wordle-how" id="how-to-play">
      <div class="wordle-shell wordle-how__grid">
        <div class="wordle-how__copy">
          <span class="wordle-kicker">HOW TO PLAY</span>
          <h2>Six tries.<br /><em>Three clues.</em></h2>
          <p>
            Guess the secret word in six tries. Each guess must be a valid
            five-letter word. After every guess, the tiles tell you how close you are.
          </p>

          <div class="wordle-clues">
            <div class="wordle-clue wordle-clue--correct">
              <span>A</span>
              <div><strong>Green</strong><p>Correct letter, correct position.</p></div>
            </div>
            <div class="wordle-clue wordle-clue--present">
              <span>P</span>
              <div><strong>Orange</strong><p>Correct letter, wrong position.</p></div>
            </div>
            <div class="wordle-clue wordle-clue--absent">
              <span>Y</span>
              <div><strong>Gray</strong><p>The letter is not in the secret word.</p></div>
            </div>
          </div>
        </div>

        <div class="wordle-example">
          <span class="wordle-example__label">EXAMPLE</span>
          <h3>If the secret word were <strong>MAPLE</strong>…</h3>
          <div class="wordle-example__tiles" aria-label="Example guess APPLY">
            <span class="is-present">A</span>
            <span class="is-absent">P</span>
            <span class="is-correct">P</span>
            <span class="is-correct">L</span>
            <span class="is-absent">Y</span>
          </div>
          <p>
            Two letters are in exactly the right place, one belongs elsewhere,
            and two do not feature in the word.
          </p>

          <div class="wordle-learner-note">
            <span>LEARNER MODE</span>
            <h3>Keep the vocabulary familiar.</h3>
            <p>
              In learner mode, the secret word is chosen from a list of common
              five-letter words.
            </p>
            <button type="button" data-show-common>Show the common words →</button>
          </div>
        </div>
      </div>
    </section>

    <section class="wordle-video">
      <div class="wordle-shell wordle-video__grid">
        <div>
          <span class="wordle-kicker wordle-kicker--lime">WATCH & LEARN</span>
          <h2>Prefer video<br />to text?</h2>
          <p>
            Craig's original Wordle page includes this video explanation. It stays
            right here alongside the game.
          </p>
          <a href="https://www.grammar-monster.com/grammar-videos.htm" target="_blank" rel="noopener">
            Browse all Grammar Monster videos ↗
          </a>
        </div>

        <div class="wordle-video__frame">
          <iframe
            loading="lazy"
            src="https://www.youtube.com/embed/OuTwsiPOzIc"
            title="Grammar Monster Wordle explanatory video"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <section class="wordle-more">
      <div class="wordle-shell">
        <div class="wordle-more__head">
          <div>
            <span class="wordle-kicker">YOU MIGHT ALSO LIKE</span>
            <h2>More ways to<br /><em>play with words.</em></h2>
          </div>
          <a href="/games/">Browse all Games & Tests →</a>
        </div>

        <div class="wordle-related-grid">
          {
            relatedGames.map((game) => (
              <a href={game.href} target="_blank" rel="noopener">
                <span>{game.number}</span>
                <div>
                  <strong>{game.title}</strong>
                  <p>{game.description}</p>
                </div>
                <b>↗</b>
              </a>
            ))
          }
        </div>

        <div class="wordle-teacher">
          <div class="wordle-teacher__copy">
            <span class="wordle-kicker wordle-kicker--lime">TEACHERS' ZONE</span>
            <h2>Useful for class,<br />not just downtime.</h2>
            <p>More games, vocabulary tools and spelling practice from Grammar Monster.</p>
          </div>
          <div class="wordle-teacher__links">
            {
              teacherLinks.map(([label, href], index) => (
                <a href={href} target={href.startsWith("http") ? "_blank" : undefined} rel={href.startsWith("http") ? "noopener" : undefined}>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{label}</strong>
                  <b>↗</b>
                </a>
              ))
            }
          </div>
        </div>

        <div class="wordle-author">
          <img src="/assets/images/grammarMonsterEye.webp" alt="" aria-hidden="true" />
          <div>
            <span>ABOUT THIS PAGE</span>
            <p>
              This page was written by
              <a href="https://www.grammar-monster.com/Craig_Shrives_author.htm" target="_blank" rel="noopener">Craig Shrives</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="wordle-ad-stage wordle-ad-stage--bottom" aria-label="Advertisement">
      <div class="wordle-shell">
        <div class="wordle-ad-stage__label">ADVERTISEMENT <span>Helping keep the game free.</span></div>
        <div class="wordle-ad-stage__slots">
          <div class="wordle-ad-slot" data-wordle-ad-shell>
            <div class="wordle-ad-placeholder">
              <span>ADVERTISEMENT</span>
              <strong>More free Grammar Monster.</strong>
              <small>Live ad inventory may appear here.</small>
            </div>
            <div class="adsbyvli" style="width:300px;height:250px" data-ad-slot="vi_342112533"></div>
          </div>
          <div class="wordle-ad-slot wordle-ad-slot--secondary" data-wordle-ad-shell>
            <div class="wordle-ad-placeholder">
              <span>ADVERTISEMENT</span>
              <strong>Learning without a paywall.</strong>
              <small>Thanks for supporting the site.</small>
            </div>
            <div class="adsbyvli" style="width:300px;height:250px" data-ad-slot="vi_342112534"></div>
          </div>
        </div>
      </div>
    </section>

    <dialog class="wordle-dialog" data-instructions-dialog>
      <div class="wordle-dialog__inner">
        <button type="button" class="wordle-dialog__close" data-close-instructions aria-label="Close instructions">×</button>
        <span class="wordle-kicker">HOW TO PLAY</span>
        <h2>Guess the secret word in 6 tries.</h2>
        <ul>
          <li>Each guess must be a valid five-letter word.</li>
          <li>Green means the letter is correct and in the correct position.</li>
          <li>Orange means the letter is in the word but in the wrong position.</li>
          <li>Gray means the letter is not in the secret word.</li>
        </ul>
        <div class="wordle-dialog__example">
          <span class="is-present">A</span><span class="is-absent">P</span><span class="is-correct">P</span><span class="is-correct">L</span><span class="is-absent">Y</span>
        </div>
        <p>
          Switch to <strong>Learner mode</strong> if you want the secret word to
          come from Grammar Monster's common-word list.
        </p>
        <button type="button" class="wordle-dialog__done" data-close-instructions>Let's play</button>
      </div>
    </dialog>

    <dialog class="wordle-dialog wordle-dialog--words" data-common-dialog>
      <div class="wordle-dialog__inner">
        <button type="button" class="wordle-dialog__close" data-close-common aria-label="Close common words">×</button>
        <span class="wordle-kicker">LEARNER MODE</span>
        <h2>Common five-letter words.</h2>
        <p>These are the words used as secret answers in learner mode.</p>
        <div class="wordle-common-list" data-common-list></div>
        <button type="button" class="wordle-dialog__done" data-close-common>Done</button>
      </div>
    </dialog>

    <div class="wordle-toast" data-wordle-toast aria-live="polite" hidden></div>
  </main>

  <script is:inline src="/assets/js/wordle/wordle-words.js"></script>
  <script is:inline src="/assets/js/wordle/wordle-game.js"></script>
</BaseLayout>
