            <div><strong>Ten questions.</strong><span>No pressure. Probably.</span></div>
          </div>
        </div>

        <aside class="home-quiz-card">
          <div class="home-quiz-card__top">
            <div><span></span> QUICK GRAMMAR CHALLENGE</div>
            <strong id="homeScore">0 correct</strong>
          </div>

          <div class="home-quiz-card__progress">
            <div><span id="homeQuestionCount">Question 1 of 10</span><span id="homeProgressPercent">10%</span></div>
            <i><b id="homeProgressBar"></b></i>
          </div>

          <h3 id="homeQuestionText"></h3>
          <div class="home-answers" id="homeAnswers"></div>
          <div class="home-feedback" id="homeFeedback" aria-live="polite"></div>

          <button id="homeNext" type="button" disabled>Next question <span>→</span></button>
        </aside>
      </div>
    </section>

    <section class="home-story">
      <div class="home-shell">
        <div class="home-story__panel">
          <div class="home-story__monster">
            <img src="/assets/images/grammarMonsterEye.webp" alt="" aria-hidden="true" />
          </div>
          <div class="home-story__copy">
            <span class="home-kicker home-kicker--lime">A NOTE FROM GRAMMAR MONSTER</span>
            <h2>A one-man show.<br /><em>With a Jack Russell exception.</em></h2>
            <p>Grammar Monster is a one-man show (if we don't count my Jack Russell). If you like the content and style, please promote it. If you're a training company, a school, or a home-school community, then please provide a link on your site to any useful Grammar Monster lessons. It really, really helps keep "the local patisseries afloat in the wake of the Walmarts."</p>
            <p class="home-story__request">
              If Grammar Monster doesn't have the lesson you need,
              <a href="https://www.grammar-monster.com/admin/contact_us.htm" target="_blank" rel="noopener">let me know</a>
              — I'll write it!
            </p>
            <p class="home-story__signoff">Thank you. Right, let's do some grammar…</p>
            <div class="home-story__author">
              <span>WRITTEN BY</span>
              <a href="https://www.grammar-monster.com/Craig_Shrives_author.htm" target="_blank" rel="noopener">Craig Shrives ↗</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="home-final">
      <div class="home-shell home-final__inner">
        <div>
          <span class="home-kicker home-kicker--lime">NO LOG-IN. EVERYTHING IS FREE.</span>
          <h2>Make friends with<br />better English.</h2>
          <p>Thousands of lessons, tests, videos, word lists and learning resources — ready whenever you are.</p>
        </div>
        <div class="home-final__actions">
          <a href="#paths">Find my learning path →</a>
          <a href="/grammar-terms/">Browse the A–Z glossary ↗</a>
          <a href="/games/">Try games & tests ↗</a>
        </div>
      </div>
    </section>
  </div>

  <script id="homePathsData" type="application/json" set:html={JSON.stringify(paths)}></script>
  <script id="homeSearchData" type="application/json" set:html={JSON.stringify(searchIndex)}></script>
  <script id="homeQuizData" type="application/json" set:html={JSON.stringify(quizQuestions)}></script>

  <script>
    const pathData = JSON.parse(document.getElementById("homePathsData")?.textContent || "[]");
    const pathTabs = [...document.querySelectorAll("[data-path-index]")];
    const pathImage = document.getElementById("pathImage");
    const pathKicker = document.getElementById("pathKicker");
    const pathTitle = document.getElementById("pathTitle");
    const pathLessons = document.getElementById("pathLessons");

    function renderPath(index) {
      const path = pathData[index];
      if (!path) return;

      pathTabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", active ? "true" : "false");
      });

      if (pathImage) pathImage.src = `/assets/images/${path.image}`;
      if (pathKicker) pathKicker.textContent = path.kicker;
      if (pathTitle) pathTitle.textContent = path.title;

      if (pathLessons) {
        pathLessons.innerHTML = "";
        path.links.forEach((link) => {
          const a = document.createElement("a");
          a.href = link.href;
          if (link.external) {
            a.target = "_blank";
            a.rel = "noopener";
          }

          const span = document.createElement("span");
          span.textContent = link.label;
          const arrow = document.createElement("b");
          arrow.textContent = "↗";
          a.append(span, arrow);
          pathLessons.appendChild(a);
        });
      }
    }

    pathTabs.forEach((tab) => {
      tab.addEventListener("click", () => renderPath(Number(tab.dataset.pathIndex || 0)));
    });

    const homeSearch = document.getElementById("homeSearch");
    const homeSearchResults = document.getElementById("homeSearchResults");
    const homeSearchData = JSON.parse(document.getElementById("homeSearchData")?.textContent || "[]");

    function renderSearch(value) {
      const term = (value || "").trim().toLowerCase();

      if (!homeSearchResults || term.length < 2) {
        if (homeSearchResults) homeSearchResults.hidden = true;
        return;
      }

      const matches = homeSearchData
        .filter((item) => `${item.label} ${item.category}`.toLowerCase().includes(term))
        .slice(0, 8);

      homeSearchResults.innerHTML = "";

      if (!matches.length) {
        const empty = document.createElement("div");
        empty.className = "home-search-empty";
        empty.textContent = "No quick match here — try the full Knowledge Navigator.";
        homeSearchResults.appendChild(empty);
      } else {
        matches.forEach((item) => {
          const a = document.createElement("a");
          a.href = item.href;

          if (item.external) {
            a.target = "_blank";
            a.rel = "noopener";
          }

          const div = document.createElement("div");
          const small = document.createElement("small");
          small.textContent = item.category;
          const strong = document.createElement("strong");
          strong.textContent = item.label;
          div.append(small, strong);

          const arrow = document.createElement("b");
          arrow.textContent = "↗";

          a.append(div, arrow);
          homeSearchResults.appendChild(a);
        });
      }

      const full = document.createElement("a");
      full.href = `/explore/?q=${encodeURIComponent(term)}`;
      full.className = "home-search-full";
      full.innerHTML = "<div><small>FULL SITE</small><strong>Search the Knowledge Navigator</strong></div><b>→</b>";
      homeSearchResults.appendChild(full);
      homeSearchResults.hidden = false;
    }

    homeSearch?.addEventListener("input", () => renderSearch(homeSearch.value));

    document.querySelectorAll("[data-search-quick]").forEach((button) => {
      button.addEventListener("click", () => {
        const value = button.dataset.searchQuick || "";
        if (homeSearch) {
          homeSearch.value = value;
          homeSearch.focus();
        }
        renderSearch(value);
      });
    });

    document.addEventListener("click", (event) => {
      if (!homeSearchResults?.contains(event.target) && event.target !== homeSearch) {
        homeSearchResults.hidden = true;
      }
    });

    document.addEventListener("keydown", (event) => {
      const tag = document.activeElement?.tagName;

      if (event.key === "/" && tag !== "INPUT" && tag !== "TEXTAREA") {
        event.preventDefault();
        homeSearch?.focus();
      }

      if (event.key === "Escape") {
        if (document.activeElement === homeSearch && homeSearch) {
          homeSearch.value = "";
          homeSearch.blur();
        }
        if (homeSearchResults) homeSearchResults.hidden = true;
      }
    });

    const quiz = JSON.parse(document.getElementById("homeQuizData")?.textContent || "[]");
    const qText = document.getElementById("homeQuestionText");
    const answers = document.getElementById("homeAnswers");
    const feedback = document.getElementById("homeFeedback");
    const next = document.getElementById("homeNext");
    const scoreEl = document.getElementById("homeScore");
    const countEl = document.getElementById("homeQuestionCount");
    const percentEl = document.getElementById("homeProgressPercent");
    const barEl = document.getElementById("homeProgressBar");

    let current = 0;
    let score = 0;
    let answered = false;

    function renderQuestion() {
      if (!quiz.length || !qText || !answers) return;

      if (current >= quiz.length) {
        qText.textContent = score === quiz.length
          ? "Perfect score. The monster approves."
          : `You scored ${score} out of ${quiz.length}.`;
        answers.innerHTML = "";
        feedback.textContent = "Want more? Head to Games & Tests.";
        feedback.className = "home-feedback is-correct";
        next.disabled = false;
        next.innerHTML = 'Play again <span>↻</span>';
        if (countEl) countEl.textContent = "Complete";
        if (percentEl) percentEl.textContent = "100%";
        if (barEl) barEl.style.width = "100%";
        return;
      }

      const question = quiz[current];
      answered = false;
      qText.textContent = question.q;
      answers.innerHTML = "";
      feedback.textContent = "";
      feedback.className = "home-feedback";
      next.disabled = true;
      next.innerHTML = current === quiz.length - 1
        ? 'See score <span>→</span>'
        : 'Next question <span>→</span>';

      if (countEl) countEl.textContent = `Question ${current + 1} of ${quiz.length}`;
      if (percentEl) percentEl.textContent = `${Math.round(((current + 1) / quiz.length) * 100)}%`;
      if (barEl) barEl.style.width = `${((current + 1) / quiz.length) * 100}%`;

      question.a.forEach((answer, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = answer;

        button.addEventListener("click", () => {
          if (answered) return;
          answered = true;

          const correct = index === question.c;
          if (correct) score++;

          [...answers.querySelectorAll("button")].forEach((btn, buttonIndex) => {
            btn.disabled = true;
            if (buttonIndex === question.c) btn.classList.add("is-correct");
            else if (buttonIndex === index && !correct) btn.classList.add("is-wrong");
          });

          feedback.textContent = question.why;
          feedback.className = `home-feedback ${correct ? "is-correct" : "is-wrong"}`;
          if (scoreEl) scoreEl.textContent = `${score} correct`;
          next.disabled = false;
        });

        answers.appendChild(button);
      });
    }

    next?.addEventListener("click", () => {
      if (current >= quiz.length) {
        current = 0;
        score = 0;
        if (scoreEl) scoreEl.textContent = "0 correct";
        renderQuestion();
        return;
      }

      current++;
      renderQuestion();
    });

    renderQuestion();

    // Existing Grammar Monster VI/VLI ad integration.
    const gmAdSlots = ["vi_342100586", "vi_342112530", "vi_342112533", "vi_342112534"];

    if (window.vitag) {
      (window.vitag.Init = window.vitag.Init || []).push(function () {
        gmAdSlots.forEach((slot) => {
          try {
            window.viAPItag?.display(slot);
          } catch (_) {
            // Keep the tasteful fallback frame visible if inventory cannot serve.
          }
        });
      });
    }

    const updateAdShell = (shell) => {
      const ad = shell.querySelector(".adsbyvli");
      const placeholder = shell.querySelector("[data-ad-placeholder]");
      if (!ad || !placeholder) return;

      const hasRenderedAd =
        ad.children.length > 0 ||
        ad.querySelector("iframe") ||
        ad.offsetHeight > 250;

      placeholder.toggleAttribute("hidden", Boolean(hasRenderedAd));
      shell.classList.toggle("has-live-ad", Boolean(hasRenderedAd));
    };

    document.querySelectorAll("[data-ad-shell]").forEach((shell) => {
      const ad = shell.querySelector(".adsbyvli");
      if (!ad) return;

      const observer = new MutationObserver(() => updateAdShell(shell));
      observer.observe(ad, { childList: true, subtree: true, attributes: true });

      window.setTimeout(() => updateAdShell(shell), 1600);
      window.setTimeout(() => updateAdShell(shell), 4000);
    });
  </script>
</BaseLayout>
