---
const year = new Date().getFullYear();

const navGroups = [
  {
    title: "Libraries",
    links: [
      { label: "A–Z of grammatical terms", href: "/grammar-terms/" },
      { label: "A–Z confused words", href: "/easily-confused-words/" },
      { label: "Punctuation lessons", href: "/punctuation-lessons/" },
      { label: "FAQs by writers", href: "https://www.grammar-monster.com/FAQs.htm" },
      { label: "Common writing errors", href: "https://www.grammar-monster.com/common_grammar_errors.htm" }
    ]
  },
  {
    title: "Beginners",
    links: [
      { label: "Curriculum for beginners", href: "https://www.grammar-monster.com/English-for-beginners.htm" },
      { label: "Spelling & vocabulary lessons", href: "/spelling-vocabulary/" },
      { label: "Role-play scenarios", href: "https://www.grammar-monster.com/role-play-scenarios.htm" },
      { label: "Vocabulary topics", href: "https://www.grammar-monster.com/ESL-vocabulary-lists.html" },
      { label: "Awkward plurals", href: "https://www.grammar-monster.com/plurals.htm" }
    ]
  },
  {
    title: "Advanced learners",
    links: [
      { label: "Parts-of-speech lists", href: "https://www.grammar-monster.com/parts_of_speech_lists.htm" },
      { label: "Creative-writing techniques", href: "https://www.grammar-monster.com/writing_techniques.htm" },
      { label: "Latin terms in English", href: "https://www.grammar-monster.com/Latin_terms_in_English.html" },
      { label: "Tattoo fails", href: "https://www.grammar-monster.com/tattoo_fails.htm" },
      { label: "Arabic script", href: "https://www.grammar-monster.com/Arabic-lessons.htm" }
    ]
  },
  {
    title: "Teaching resources",
    links: [
      { label: "Categorized games & tests", href: "/games/" },
      { label: "Key-stage tests", href: "https://www.grammar-monster.com/key-stage-tests.htm" },
      { label: "Library of grammar videos", href: "https://www.grammar-monster.com/grammar-videos.htm" },
      { label: "PDF download library", href: "https://www.grammar-monster.com/pdf-library.htm" },
      { label: "Categorized sitemap", href: "/explore/" }
    ]
  },
  {
    title: "Word lists",
    links: [
      { label: "Common English verbs", href: "https://www.grammar-monster.com/most-common-verbs-in-English.htm" },
      { label: "Collective nouns for animals", href: "https://www.grammar-monster.com/list_of_collective_nouns_for_animals.htm" },
      { label: "Sayings and proverbs", href: "https://www.grammar-monster.com/sayings_proverbs.htm" },
      { label: "Common irregular verbs", href: "https://www.grammar-monster.com/important-irregular-verbs.htm" },
      { label: "Interesting words", href: "https://www.grammar-monster.com/favourite-words-the-top-tens.htm" }
    ]
  }
];

const utilityCards = [
  {
    id: "report",
    eyebrow: "SPOTTED SOMETHING?",
    title: "Was something wrong?",
    text: "Found a typo, unclear explanation or something that needs attention?",
    action: "Please tell us",
    href: "https://www.grammar-monster.com/admin/contact_us.htm",
    icon: "!"
  },
  {
    id: "gm",
    eyebrow: "FIND US QUICKER",
    title: "Use #gm",
    text: "Grammar Monster’s shorthand for finding and sharing useful pages quickly.",
    action: "More info",
    href: "https://www.grammar-monster.com/admin/hashtag-GM.htm",
    icon: "#"
  },
  {
    id: "share",
    eyebrow: "SHARE THIS PAGE",
    title: "Send it on",
    text: "Share the page you’re reading or copy its link in one click.",
    action: "Share page",
    href: "#share",
    icon: "↗"
  },
  {
    id: "qr",
    eyebrow: "CLASSROOM READY",
    title: "Create a QR code",
    text: "Turn this page into a scannable code for lessons, handouts or screens.",
    action: "Create QR",
    href: "#qr",
    icon: "⌗"
  }
];

const socialLinks = [
  {
    label: "X / Twitter",
    href: "https://twitter.com/grammarmonster",
    icon: "x"
  },
  {
    label: "YouTube",
    href: "https://www.youtube.com/c/GrammarMonsterVideos",
    icon: "youtube"
  },
  {
    label: "Mailing list",
    href: "https://www.grammar-monster.com/admin/newsletter.htm",
    icon: "mail"
  },
  {
    label: "Grammar forum",
    href: "https://www.grammar-monster.com/admin/grammar-chat-forum.htm",
    icon: "chat"
  }
];

const bottomLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "https://www.grammar-monster.com/about_us.htm" },
  { label: "Craig", href: "https://www.grammar-monster.com/Craig_Shrives_author.htm" },
  { label: "Contact", href: "https://www.grammar-monster.com/admin/contact_us.htm" },
  { label: "Sitemap", href: "/explore/" },
  { label: "Privacy", href: "https://www.grammar-monster.com/admin/privacy_policy.htm" }
];

const isExternal = (href) => href.startsWith("http://") || href.startsWith("https://");
---

<footer class="gm-footer-v3">
  <section class="gm-help" aria-labelledby="gm-help-title">
    <div class="gm-help__inner">
      <div class="gm-help__head">
        <div>
          <span>HELP US IMPROVE</span>
          <h2 id="gm-help-title">Grammar Monster gets better<br /><em>when readers help.</em></h2>
        </div>

        <p>
          Report an issue, share a useful page, create a classroom QR code or
          learn how to use <strong>#gm</strong>.
        </p>
      </div>

      <div class="gm-help__grid">
        {
          utilityCards.map((card, index) => (
            <article class:list={["gm-help-card", `gm-help-card--${index + 1}`]}>
              <div class="gm-help-card__icon" aria-hidden="true">{card.icon}</div>
              <div class="gm-help-card__copy">
                <small>{card.eyebrow}</small>
                <h3>{card.title}</h3>
                <p>{card.text}</p>
              </div>

              {
                card.id === "share" ? (
                  <div class="gm-help-card__actions">
                    <button type="button" data-footer-share>{card.action}<span>↗</span></button>
                    <button type="button" class="gm-help-card__mini" data-footer-copy>Copy link</button>
                  </div>
                ) : card.id === "qr" ? (
                  <button type="button" class="gm-help-card__action" data-footer-qr>
                    {card.action}<span>↗</span>
                  </button>
                ) : (
                  <a
                    class="gm-help-card__action"
                    href={card.href}
                    target="_blank"
                    rel="noopener"
                  >
                    {card.action}<span>↗</span>
                  </a>
                )
              }
            </article>
          ))
        }
      </div>

      <div class="gm-help__status" aria-live="polite" data-footer-status></div>
    </div>
  </section>

  <section class="gm-footer-main">
    <div class="gm-footer-main__orb gm-footer-main__orb--one"></div>
    <div class="gm-footer-main__orb gm-footer-main__orb--two"></div>

    <div class="gm-footer-main__inner">
      <div class="gm-footer-brand">
        <a href="/" class="gm-footer-brand__logo" aria-label="Grammar Monster home">
          <span>
            <img src="/assets/images/grammarMonsterEye.webp" alt="" />
          </span>
          <div>Grammar <strong>Monster</strong></div>
        </a>

        <p>
          Clear explanations, useful practice and a little monster mischief —
          helping English make more sense.
        </p>

        <div class="gm-footer-brand__promise">
          <i></i>
          <strong>2,000+ free lessons</strong>
          <span>No login required</span>
        </div>

        <div class="gm-footer-socials" aria-label="Grammar Monster links">
          {
            socialLinks.map((social) => (
              <a href={social.href} target="_blank" rel="noopener">
                <span class="gm-footer-socials__icon" aria-hidden="true">
                  {social.icon === "x" && (
                    <svg viewBox="0 0 24 24"><path d="M18.7 3H22l-7.2 8.2L23.3 21h-6.6l-5.2-6.8L5.6 21H2.3l7.7-8.8L1.8 3h6.8l4.7 6.2L18.7 3Zm-1.2 16h1.8L7.6 4.9H5.7L17.5 19Z"/></svg>
                  )}
                  {social.icon === "youtube" && (
                    <svg viewBox="0 0 24 24"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4L15.9 12l-6.3 3.6Z"/></svg>
                  )}
                  {social.icon === "mail" && (
                    <svg viewBox="0 0 24 24"><path d="M3.5 5h17A2.5 2.5 0 0 1 23 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-17A2.5 2.5 0 0 1 1 16.5v-9A2.5 2.5 0 0 1 3.5 5Zm.2 2 8.3 6.1L20.3 7H3.7Zm17.3 1.5-8.4 6.2a1 1 0 0 1-1.2 0L3 8.5v8a.5.5 0 0 0 .5.5h17a.5.5 0 0 0 .5-.5v-8Z"/></svg>
                  )}
                  {social.icon === "chat" && (
                    <svg viewBox="0 0 24 24"><path d="M4 3h16a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H9l-5.5 3.2A1 1 0 0 1 2 21.3V19a3 3 0 0 1-1-2.2V6a3 3 0 0 1 3-3Zm0 2a1 1 0 0 0-1 1v10.8a1 1 0 0 0 .7 1l.3.1V20l4.2-2.5A1 1 0 0 1 8.7 17H20a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1H4Z"/></svg>
                  )}
                </span>
                <span>{social.label}</span>
                <b aria-hidden="true">↗</b>
              </a>
            ))
          }
        </div>
      </div>

      <div class="gm-footer-navigation">
        <div class="gm-footer-navigation__title">
          <span>SITE NAVIGATION</span>
          <strong>Keep exploring.</strong>
        </div>

        <div class="gm-footer-navigation__grid">
          {
            navGroups.map((group) => (
              <div class="gm-footer-navigation__group">
                <strong>{group.title}</strong>
                <div>
                  {
                    group.links.map((link) => (
                      <a
                        href={link.href}
                        target={isExternal(link.href) ? "_blank" : undefined}
                        rel={isExternal(link.href) ? "noopener" : undefined}
                      >
                        <span>{link.label}</span>
                        {isExternal(link.href) && <b aria-hidden="true">↗</b>}
                      </a>
                    ))
                  }
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="gm-footer-bottom">
      <div>
        <span>© {year} Grammar Monster</span>
        <span>English, made brilliantly clear.</span>
      </div>

      <nav aria-label="Footer">
        {
          bottomLinks.map((link) => (
            <a
              href={link.href}
              target={isExternal(link.href) ? "_blank" : undefined}
              rel={isExternal(link.href) ? "noopener" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <dialog class="gm-qr-dialog" data-qr-dialog>
    <div class="gm-qr-dialog__inner">
      <button type="button" class="gm-qr-dialog__close" aria-label="Close QR code" data-qr-close>×</button>

      <span>SHARE THIS PAGE</span>
      <h2>Scan to open this page.</h2>
      <p data-qr-title></p>

      <div class="gm-qr-dialog__code">
        <img alt="QR code for this page" data-qr-image />
      </div>

      <small>
        Prototype QR generation uses an external QR-image service. For the final
        migration, this can be replaced with Grammar Monster’s existing local QR function.
      </small>

      <div class="gm-qr-dialog__actions">
        <button type="button" data-qr-copy>Copy page link</button>
        <button type="button" data-qr-close>Done</button>
      </div>
    </div>
  </dialog>
</footer>

<script>
  const footerStatus = document.querySelector("[data-footer-status]");
  const shareButton = document.querySelector("[data-footer-share]");
  const copyButton = document.querySelector("[data-footer-copy]");
  const qrButton = document.querySelector("[data-footer-qr]");
  const qrDialog = document.querySelector("[data-qr-dialog]");
  const qrImage = document.querySelector("[data-qr-image]");
  const qrTitle = document.querySelector("[data-qr-title]");
  const qrCopy = document.querySelector("[data-qr-copy]");
  const qrCloseButtons = document.querySelectorAll("[data-qr-close]");

  const setFooterStatus = (message) => {
    if (!footerStatus) return;
    footerStatus.textContent = message;
    window.setTimeout(() => {
      if (footerStatus.textContent === message) footerStatus.textContent = "";
    }, 2600);
  };

  const copyCurrentUrl = async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      setFooterStatus("Page link copied.");
    } catch {
      const input = document.createElement("textarea");
      input.value = window.location.href;
      input.setAttribute("readonly", "");
      input.style.position = "fixed";
      input.style.opacity = "0";
      document.body.appendChild(input);
      input.select();
      document.execCommand("copy");
      input.remove();
      setFooterStatus("Page link copied.");
    }
  };

  shareButton?.addEventListener("click", async () => {
    if (navigator.share) {
      try {
        await navigator.share({
          title: document.title,
          text: "Take a look at this Grammar Monster page.",
          url: window.location.href
        });
      } catch (error) {
        if (error?.name !== "AbortError") await copyCurrentUrl();
      }
    } else {
      await copyCurrentUrl();
    }
  });

  copyButton?.addEventListener("click", copyCurrentUrl);
  qrCopy?.addEventListener("click", copyCurrentUrl);

  qrButton?.addEventListener("click", () => {
    if (!qrDialog || !qrImage) return;

    const pageUrl = window.location.href;
    const qrUrl =
      "https://quickchart.io/qr?size=320&margin=2&text=" +
      encodeURIComponent(pageUrl);

    qrImage.src = qrUrl;
    if (qrTitle) qrTitle.textContent = document.title;
    qrDialog.showModal();
  });

  qrCloseButtons.forEach((button) => {
    button.addEventListener("click", () => qrDialog?.close());
  });

  qrDialog?.addEventListener("click", (event) => {
    if (event.target === qrDialog) qrDialog.close();
  });
</script>

<style>
  .gm-footer-v3{
    --gm-ink:#10271e;
    --gm-green:#086a4f;
    --gm-deep:#04281e;
    --gm-deeper:#031b15;
    --gm-lime:#a7ef62;
    --gm-cream:#fbfcf7;
    --gm-line:#dce7dd;
    --gm-muted:#667a70;
    margin-top:clamp(64px,8vw,104px);
  }

  /* ---------- Help us improve ---------- */
  .gm-help{
    background:
      radial-gradient(circle at 90% 0,rgba(167,239,98,.11),transparent 26%),
      linear-gradient(180deg,#f8fbf5 0%,#f2f7ef 100%);
    border-top:1px solid #e2ebe2;
  }

  .gm-help__inner{
    width:min(1180px,calc(100% - 40px));
    margin:0 auto;
    padding:56px 0 58px;
  }

  .gm-help__head{
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(300px,430px);
    gap:64px;
    align-items:end;
    margin-bottom:28px;
  }

  .gm-help__head>div>span,
  .gm-footer-navigation__title>span{
    display:block;
    color:var(--gm-green);
    font-size:11px;
    font-weight:850;
    letter-spacing:.13em;
  }

  .gm-help__head h2{
    margin:8px 0 0;
    max-width:760px;
    font-family:"Manrope",sans-serif;
    font-size:clamp(36px,4.6vw,56px);
    line-height:1;
    letter-spacing:-.055em;
  }

  .gm-help__head h2 em{
    color:var(--gm-green);
    font-style:normal;
  }

  .gm-help__head>p{
    margin:0;
    color:var(--gm-muted);
    font-size:15px;
    line-height:1.7;
  }

  .gm-help__grid{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:11px;
  }

  .gm-help-card{
    --accent:#08745a;
    --soft:rgba(8,116,90,.10);
    min-height:250px;
    display:flex;
    flex-direction:column;
    padding:20px;
    border:1px solid #dbe6db;
    border-radius:20px;
    background:
      radial-gradient(circle at 90% 6%,var(--soft),transparent 35%),
      #fff;
    box-shadow:0 14px 38px rgba(15,67,48,.05);
  }

  .gm-help-card--2{--accent:#4f8fd8;--soft:rgba(79,143,216,.11)}
  .gm-help-card--3{--accent:#8c76c8;--soft:rgba(140,118,200,.11)}
  .gm-help-card--4{--accent:#d6a33f;--soft:rgba(214,163,63,.12)}

  .gm-help-card__icon{
    width:44px;
    height:44px;
    display:grid;
    place-items:center;
    margin-bottom:25px;
    border-radius:14px;
    background:var(--soft);
    color:var(--accent);
    font:850 17px/1 "Manrope",sans-serif;
  }

  .gm-help-card__copy small{
    display:block;
    color:var(--accent);
    font-size:9px;
    font-weight:850;
    letter-spacing:.11em;
  }

  .gm-help-card__copy h3{
    margin:7px 0 0;
    font-family:"Manrope",sans-serif;
    color:var(--gm-ink);
    font-size:20px;
    letter-spacing:-.035em;
  }

  .gm-help-card__copy p{
    margin:8px 0 0;
    color:#6d7e75;
    font-size:13.5px;
    line-height:1.55;
  }

  .gm-help-card__action,
  .gm-help-card__actions{
    margin-top:auto;
    padding-top:22px;
  }

  .gm-help-card__action,
  .gm-help-card__actions button{
    min-height:42px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    padding:0 14px;
    border:0;
    border-radius:999px;
    background:var(--gm-ink);
    color:#fff;
    text-decoration:none;
    font:850 12px/1 "DM Sans",sans-serif;
    cursor:pointer;
  }

  .gm-help-card__action span,
  .gm-help-card__actions button span{
    color:var(--gm-lime);
  }

  .gm-help-card__actions{
    display:flex;
    gap:7px;
  }

  .gm-help-card__actions button:first-child{
    flex:1;
  }

  .gm-help-card__actions .gm-help-card__mini{
    min-width:78px;
    justify-content:center;
    background:#edf3eb;
    color:#53675d;
  }

  .gm-help__status{
    min-height:18px;
    margin-top:11px;
    color:var(--gm-green);
    text-align:right;
    font-size:12px;
    font-weight:750;
  }

  /* ---------- Main footer ---------- */
  .gm-footer-main{
    position:relative;
    overflow:hidden;
    color:#fff;
    background:
      radial-gradient(circle at 9% 9%,rgba(167,239,98,.09),transparent 24%),
      linear-gradient(145deg,#07372a 0%,var(--gm-deep) 48%,var(--gm-deeper) 100%);
  }

  .gm-footer-main__orb{
    position:absolute;
    border-radius:50%;
    pointer-events:none;
  }

  .gm-footer-main__orb--one{
    width:280px;
    height:280px;
    top:-145px;
    right:8%;
    border:1px solid rgba(167,239,98,.08);
    box-shadow:0 0 0 48px rgba(167,239,98,.018),0 0 0 96px rgba(167,239,98,.01);
  }

  .gm-footer-main__orb--two{
    width:180px;
    height:180px;
    bottom:-110px;
    left:-70px;
    background:radial-gradient(circle,rgba(167,239,98,.07),transparent 70%);
  }

  .gm-footer-main__inner{
    position:relative;
    z-index:1;
    width:min(1180px,calc(100% - 40px));
    margin:0 auto;
    padding:54px 0 42px;
    display:grid;
    grid-template-columns:320px 1fr;
    gap:54px;
    align-items:start;
  }

  .gm-footer-brand__logo{
    display:inline-flex;
    align-items:center;
    gap:12px;
    color:#fff;
    text-decoration:none;
  }

  .gm-footer-brand__logo>span{
    width:53px;
    height:53px;
    display:grid;
    place-items:center;
    border:1px solid rgba(255,255,255,.08);
    border-radius:16px;
    background:rgba(255,255,255,.06);
  }

  .gm-footer-brand__logo img{
    width:48px;
    height:48px;
    object-fit:contain;
  }

  .gm-footer-brand__logo>div{
    font-family:"Manrope",sans-serif;
    font-size:23px;
    font-weight:750;
    letter-spacing:-.04em;
  }

  .gm-footer-brand__logo strong{
    color:var(--gm-lime);
    font-weight:850;
  }

  .gm-footer-brand>p{
    margin:18px 0 0;
    color:#b8cac1;
    font-size:14px;
    line-height:1.68;
  }

  .gm-footer-brand__promise{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:7px;
    margin-top:18px;
    color:#fff;
    font-size:12.5px;
  }

  .gm-footer-brand__promise i{
    width:8px;
    height:8px;
    border-radius:50%;
    background:var(--gm-lime);
    box-shadow:0 0 0 6px rgba(167,239,98,.07);
  }

  .gm-footer-brand__promise span{
    color:#91aa9e;
  }

  .gm-footer-socials{
    display:grid;
    gap:6px;
    margin-top:25px;
  }

  .gm-footer-socials a{
    min-height:45px;
    display:grid;
    grid-template-columns:31px 1fr auto;
    gap:10px;
    align-items:center;
    padding:6px 10px;
    border:1px solid rgba(255,255,255,.07);
    border-radius:11px;
    background:rgba(255,255,255,.035);
    color:#d5e1db;
    text-decoration:none;
    font-size:12px;
    font-weight:750;
    transition:.16s ease;
  }

  .gm-footer-socials a:hover{
    transform:translateX(2px);
    border-color:rgba(167,239,98,.16);
    background:rgba(255,255,255,.06);
    color:#fff;
  }

  .gm-footer-socials__icon{
    width:30px;
    height:30px;
    display:grid;
