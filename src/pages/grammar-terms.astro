  <script>
    const search = document.getElementById("termSearch");
    const terms = [...document.querySelectorAll("[data-term]")];
    const groups = [...document.querySelectorAll("[data-term-group]")];
    const count = document.getElementById("termCount");
    const empty = document.getElementById("termEmpty");

    function filterTerms(value) {
      const term = (value || "").trim().toLowerCase();
      let visible = 0;

      groups.forEach((group) => {
        let groupVisible = 0;

        group.querySelectorAll("[data-term]").forEach((item) => {
          const match = !term || (item.dataset.search || "").includes(term);
          item.hidden = !match;

          if (match) {
            visible++;
            groupVisible++;
          }
        });

        group.hidden = groupVisible === 0;
      });

      if (count) count.textContent = `${visible} ${visible === 1 ? "term" : "terms"}`;
      if (empty) empty.hidden = visible !== 0;
    }

    search?.addEventListener("input", () => filterTerms(search.value));

    document.getElementById("clearTerms")?.addEventListener("click", () => {
      if (search) {
        search.value = "";
        search.focus();
      }
      filterTerms("");
    });

    document.querySelectorAll("[data-letter]").forEach((button) => {
      button.addEventListener("click", () => {
        const letter = button.dataset.letter;
        const target = document.querySelector(`[data-letter-section="${letter}"]`);

        if (search) search.value = "";
        filterTerms("");

        target?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    document.addEventListener("keydown", (event) => {
      const tag = document.activeElement?.tagName;

      if (event.key === "/" && tag !== "INPUT" && tag !== "TEXTAREA") {
        event.preventDefault();
        search?.focus();
      }

      if (event.key === "Escape" && document.activeElement === search) {
        search.value = "";
        filterTerms("");
        search.blur();
      }
    });
  </script>
