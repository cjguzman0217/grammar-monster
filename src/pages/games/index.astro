---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/games.css";

const featured = [
  {
    title: "Wordle",
    description: "Find the hidden five-letter word in six tries. A daily vocabulary challenge with learner and advanced modes.",
    tag: "DAILY WORD GAME",
    meta: "5 letters • 6 tries",
    href: "/games/wordle/",
    icon: "W",
    className: "feature-wordle"
  },
  {
    title: "WordUp!",
    description: "Build words quickly, test your vocabulary and keep the pressure on.",
    tag: "VOCABULARY",
    meta: "Fast-paced",
    href: "#",
    icon: "↑",
    className: "feature-wordup"
  },
  {
    title: "Word Builder",
    description: "Turn letters into words and stretch your vocabulary one combination at a time.",
    tag: "WORD GAME",
    meta: "Build & discover",
    href: "#",
    icon: "Aa",
    className: "feature-builder"
  }
];

const games = [
  { title: "Hangman", category: "Vocabulary", difficulty: "All levels", icon: "◌", href: "#" },
  { title: "Countdown", category: "Word game", difficulty: "Intermediate", icon: "10", href: "#" },
  { title: "Speed Test", category: "Grammar", difficulty: "Timed", icon: "⚡", href: "#" },
  { title: "Memory Test", category: "Vocabulary", difficulty: "All levels", icon: "◆", href: "#" },
  { title: "Confused Words Tetris", category: "Confused words", difficulty: "Intermediate", icon: "▦", href: "#" },
  { title: "Confidence Game", category: "Grammar", difficulty: "Advanced", icon: "✓", href: "#" }
];

const testCollections = [
  {
    title: "Grammar Tests",
    description: "Parts of speech, clauses, agreement, verb forms and the rules behind clear English.",
    count: "100s of tests",
    icon: "Aa",
    items: ["Parts of speech", "Verb tenses", "Pronouns", "Clauses"]
  },
  {
    title: "Punctuation Tests",
    description: "Commas, apostrophes, semicolons, quotation marks and everything in between.",
    count: "Topic practice",
    icon: ",;",
    items: ["Commas", "Apostrophes", "Semicolons", "Quotation marks"]
  },
  {
    title: "Vocabulary & Confused Words",
    description: "Choose the right word, sharpen definitions and practise commonly confused pairs.",
    count: "Vocabulary practice",
    icon: "ABC",
    items: ["Affect or effect?", "Advice or advise?", "Word choice", "Definitions"]
  },
  {
    title: "Teacher & Classroom Practice",
    description: "Quick checks, shareable activities and classroom-friendly practice for lessons and homework.",
    count: "Teacher tools",
    icon: "✎",
    items: ["Quick checks", "Homework practice", "Printable tests", "Classroom games"]
  }
];
---

<BaseLayout
  title="Games & Tests | Grammar Monster"
  description="Explore Grammar Monster games, grammar tests, vocabulary challenges and classroom practice."
>
  <div class="games-page">
    <section class="games-hero">
      <div class="games-shell games-hero__grid">
        <div class="games-hero__copy">
          <div class="games-eyebrow">
            <span></span>
            PRACTISE. PLAY. REMEMBER.
          </div>

          <h1>Games & tests<br><span>without the boring bits.</span></h1>

          <p>
            Turn grammar, vocabulary and punctuation into something you can actually
            practise. Pick a game, test yourself by topic or find a quick classroom challenge.
          </p>

          <div class="games-search">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m21 21-4.2-4.2m1.2-5.8A7 7 0 1 1 4 11a7 7 0 0 1 14 0Z"/>
            </svg>
            <input
              id="gameSearch"
              type="search"
              placeholder="Search Wordle, commas, verbs, vocabulary..."
              aria-label="Search games and tests"
            />
            <button id="gameSearchBtn" type="button">Search</button>
          </div>

          <div class="games-filter-row" aria-label="Filter games and tests">
            <button class="games-filter is-active" data-filter="all">All</button>
            <button class="games-filter" data-filter="games">Games</button>
            <button class="games-filter" data-filter="grammar">Grammar</button>
            <button class="games-filter" data-filter="punctuation">Punctuation</button>
            <button class="games-filter" data-filter="vocabulary">Vocabulary</button>
            <button class="games-filter" data-filter="teachers">Teachers</button>
          </div>
        </div>

        <div class="games-hero__art">
          <div class="games-orb"></div>
          <div class="letter-card lc-one">A</div>
          <div class="letter-card lc-two">?</div>
          <div class="letter-card lc-three">✓</div>
          <img src="/assets/images/grammarMonsterEye.webp" alt="" aria-hidden="true" />

          <div class="games-tip">
            <span>MONSTER PICK</span>
            <strong>Start with today’s Wordle.</strong>
            <a href="/games/wordle/">Play now →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="featured-section">
      <div class="games-shell">
        <div class="games-section-head">
          <div>
            <span class="games-kicker">FEATURED GAMES</span>
            <h2>Start with something fun.</h2>
          </div>
          <p>
            Quick challenges for spelling, vocabulary, pattern recognition and grammar instinct.
          </p>
        </div>

        <div class="featured-grid">
          {featured.map((item) => (
            <article
              class:list={["featured-card", item.className]}
              data-type="games"
              data-search={`${item.title} ${item.description} ${item.tag}`}
            >
              <div class="featured-card__top">
                <span class="featured-tag">{item.tag}</span>
                <span class="featured-meta">{item.meta}</span>
              </div>

              <div class="featured-icon">{item.icon}</div>

              <h3>{item.title}</h3>
              <p>{item.description}</p>

              <a href={item.href}>
                {item.href === "#" ? "Coming soon" : "Play now"}
                <span>↗</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="quick-section">
      <div class="games-shell">
        <div class="games-section-head compact-head">
          <div>
            <span class="games-kicker">QUICK GAMES</span>
            <h2>Pick a challenge.</h2>
          </div>
        </div>

        <div class="quick-grid">
          {games.map((game) => (
            <a
              href={game.href}
              class="quick-card"
              data-type={`games ${game.category.toLowerCase()}`}
              data-search={`${game.title} ${game.category} ${game.difficulty}`}
            >
              <div class="quick-icon">{game.icon}</div>
              <div class="quick-copy">
                <strong>{game.title}</strong>
                <span>{game.category} • {game.difficulty}</span>
              </div>
              <b>→</b>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="test-section">
      <div class="games-shell">
        <div class="games-section-head">
          <div>
            <span class="games-kicker">TEST YOURSELF BY TOPIC</span>
            <h2>Find exactly what you need.</h2>
          </div>
          <p>
            Use these collections as the doorway into Grammar Monster’s much larger test library.
          </p>
        </div>

        <div class="test-grid">
          {testCollections.map((collection, index) => (
            <article
              class="test-card"
              data-type={
                index === 0 ? "grammar" :
                index === 1 ? "punctuation" :
                index === 2 ? "vocabulary" :
                "teachers"
              }
              data-search={`${collection.title} ${collection.description} ${collection.items.join(" ")}`}
            >
              <div class="test-card__icon">{collection.icon}</div>

              <div class="test-card__head">
                <span>{collection.count}</span>
                <h3>{collection.title}</h3>
                <p>{collection.description}</p>
              </div>

              <div class="test-card__links">
                {collection.items.map((item) => (
                  <a href="#">
                    <span>{item}</span>
                    <b>→</b>
                  </a>
                ))}
              </div>

              <a class="test-card__all" href="#">
                Explore all
                <span>↗</span>
              </a>
            </article>
          ))}
        </div>

        <p id="gamesNoResults" class="games-no-results" hidden>
          No matching demo games or tests yet. Try “Wordle”, “grammar”, “commas” or “vocabulary”.
        </p>
      </div>
    </section>

    <section class="games-cta">
      <div class="games-shell games-cta__inner">
        <div class="games-cta__monster">
          <div></div>
          <img src="/assets/images/grammarMonsterEye.webp" alt="" aria-hidden="true" />
        </div>

        <div class="games-cta__copy">
          <span>READY?</span>
          <h2>One word. Six tries.</h2>
          <p>Try the Grammar Monster Wordle prototype while the rest of the games library gets its new home.</p>
        </div>

        <a href="/games/wordle/">Play Wordle <span>→</span></a>
      </div>
    </section>
  </div>

  <script>
    const searchInput = document.getElementById("gameSearch");
    const searchButton = document.getElementById("gameSearchBtn");
    const filters = [...document.querySelectorAll(".games-filter")];
    const searchableCards = [...document.querySelectorAll("[data-search]")];
    const noResults = document.getElementById("gamesNoResults");

    let activeFilter = "all";

    function applyGamesFilter() {
      const term = searchInput?.value.trim().toLowerCase() || "";
      let visible = 0;

      searchableCards.forEach((card) => {
        const haystack = (card.getAttribute("data-search") || "").toLowerCase();
        const types = (card.getAttribute("data-type") || "").toLowerCase();

        const matchesSearch = !term || haystack.includes(term);
        const matchesFilter = activeFilter === "all" || types.includes(activeFilter);

        const show = matchesSearch && matchesFilter;
        card.classList.toggle("is-hidden", !show);

        if (show) visible++;
      });

      if (noResults) noResults.hidden = visible !== 0;
    }

    filters.forEach((button) => {
      button.addEventListener("click", () => {
        activeFilter = button.dataset.filter || "all";

        filters.forEach((item) => item.classList.remove("is-active"));
        button.classList.add("is-active");

        applyGamesFilter();
      });
    });

    searchButton?.addEventListener("click", applyGamesFilter);

    searchInput?.addEventListener("keydown", (event) => {
      if (event.key === "Enter") applyGamesFilter();
    });
  </script>
</BaseLayout>
